NODE_ENV=development

# Docker Compose local database defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=synk_ai

# App connection strings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synk_ai?schema=public
REDIS_URL=redis://localhost:6379

# GitHub App credentials (see docs/github-app-setup.md)
GITHUB_APP_ID=
# Paste the full PEM contents, replacing real newlines with \n, e.g.:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
