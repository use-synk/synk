# =============================================================================
# Root environment — shared across all apps and packages.
# Copy this file to .env and fill in the values.
#
# Per-package .env files are loaded ON TOP of this file and contain only
# values that are specific to or override a particular app/package.
# =============================================================================

NODE_ENV="development"

# -----------------------------------------------------------------------------
# Docker Compose (local infrastructure)
# -----------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="synk_ai"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synk_ai?schema=public"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# GitHub App (see docs/github-app-setup.md)
# Register at https://github.com/settings/apps
# -----------------------------------------------------------------------------
GITHUB_APP_ID="YOUR_GITHUB_APP_ID"
GITHUB_APP_SLUG="YOUR_GITHUB_APP_SLUG"

# Paste the full PEM contents, replacing real newlines with \n, e.g.:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY="YOUR_GITHUB_PRIVATE_KEY"
GITHUB_PRIVATE_KEY_SHA="YOUR_GITHUB_PRIVATE_KEY_SHA"

GITHUB_WEBHOOK_SECRET="YOUR_GITHUB_WEBHOOK_SECRET"

# GitHub OAuth App / GitHub App OAuth credentials
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Optional: restrict webhook-triggered actions to a single organization
GITHUB_WEBHOOK_ORGANIZATION_ID="YOUR_GITHUB_WEBHOOK_ORGANIZATION_ID"

# -----------------------------------------------------------------------------
# Better Auth (https://www.better-auth.com)
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET_AT_LEAST_32_CHARACTERS_LONG"
BETTER_AUTH_URL="http://localhost:3030"

# -----------------------------------------------------------------------------
# AI / OpenRouter (https://openrouter.ai/keys)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
