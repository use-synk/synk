# API-specific configuration — shared vars are loaded from root .env via --env-file=../../.env.
# Only define values here that are specific to this app or override the root .env.

# HTTP server
PORT=3000
HOST=0.0.0.0

# CORS origin for browser requests. When using credentials/cookies, this
# must be an explicit origin (wildcard "*" is invalid).
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Version — injected at build time (e.g. via Docker build arg or CI)
GIT_SHA=local-dev
