NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# CORS — use "*" to allow all origins, or a specific origin URL
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Version — injected at build time (e.g. via Docker build arg or CI)
GIT_SHA=local-dev

# Redis connection for webhook queueing
REDIS_URL=redis://localhost:6379

# GitHub webhook signature verification
GITHUB_WEBHOOK_SECRET=replace-me
