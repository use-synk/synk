NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# CORS origin for browser requests. When using credentials/cookies, this
# must be an explicit origin (wildcard "*" is invalid).
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Version — injected at build time (e.g. via Docker build arg or CI)
GIT_SHA=local-dev

# Redis connection for webhook queueing
REDIS_URL=redis://localhost:6379

# GitHub App credentials (required for installation repository sync)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# GitHub webhook signature verification
GITHUB_WEBHOOK_SECRET=replace-me

# Optional fallback organization for installation.created webhooks
# If unset, only existing installation mappings can be updated.
GITHUB_WEBHOOK_ORGANIZATION_ID=
