{
	"name": "@synk-ai/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --hot src/server.ts",
		"build": "bun build src/server.ts --outdir dist --format esm --target bun --sourcemap",
		"lint": "biome check .",
		"lint:write": "biome check . --write",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test src/__tests__ --coverage",
		"openapi:generate": "bun run src/openapi/generate-openapi.ts"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.2.2",
		"@synk-ai/auth": "workspace:*",
		"@synk-ai/db": "workspace:*",
		"@synk-ai/github": "workspace:*",
		"@synk-ai/shared": "workspace:*",
		"bullmq": "^5.58.5",
		"hono": "^4.12.0",
		"pino": "^9.7.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@synk-ai/test-utils": "workspace:*",
		"@types/node": "^22.17.2",
		"pino-pretty": "^13.0.0",
		"typescript": "5.9.2"
	}
}
