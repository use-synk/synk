# Web-specific configuration — shared vars are loaded from root .env via --env-file=../../.env.
# Only define values here that are specific to this app or override the root .env.
# When adding additional environment variables, also update src/env.js.

# Better Auth GitHub OAuth
# Use the OAuth client ID (non-numeric; for GitHub Apps this is typically like Iv1.xxxxx),
# not the numeric GitHub App ID.
BETTER_AUTH_GITHUB_CLIENT_ID=

# API URL exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:3030/api/v1
NEXT_PUBLIC_SYNK_SUGGESTION_INBOX_ENABLED=false
NEXT_PUBLIC_SYNK_SUGGESTION_DECISION_MEMORY_ENABLED=false

# Better Auth API key for machine-to-machine requests
BETTER_AUTH_API_KEY=
