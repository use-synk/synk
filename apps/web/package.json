{
	"name": "@synk-ai/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun --env-file=../../.env --env-file=.env x --bun next build",
		"lint": "biome check .",
		"lint:write": "biome check . --write",
		"lint:unsafe": "biome check . --write --unsafe",
		"check": "bun run lint",
		"check:unsafe": "bun run lint:unsafe",
		"check:write": "bun run lint:write",
		"dev": "bun --env-file=../../.env --env-file=.env x --bun next dev --turbo",
		"preview": "bun --env-file=../../.env --env-file=.env x --bun next build && bun --env-file=../../.env --env-file=.env x --bun next start",
		"start": "bun --env-file=../../.env --env-file=.env x --bun next start",
		"test": "bun test src --coverage",
		"typecheck": "bunx --bun next typegen && bunx tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.2.0",
		"@synk-ai/auth": "workspace:*",
		"@synk-ai/db": "workspace:*",
		"@synk-ai/shared": "workspace:*",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-form": "^1.28.3",
		"@tanstack/react-query": "^5.69.0",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"diff": "^8.0.3",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.574.0",
		"next": "^15.2.3",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"nuqs": "^2.8.8",
		"react": "^19.0.0",
		"react-day-picker": "^9.13.2",
		"react-dom": "^19.0.0",
		"react-resizable-panels": "^4.6.4",
		"recharts": "2.15.4",
		"server-only": "^0.0.1",
		"shiki": "^4.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.1",
		"vaul": "^1.1.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@shikijs/transformers": "^4.0.1",
		"@tailwindcss/postcss": "^4.0.15",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@types/diff": "^8.0.0",
		"@types/node": "^22.17.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"postcss": "^8.5.3",
		"shadcn": "^3.8.5",
		"tailwindcss": "^4.0.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.2"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	}
}
