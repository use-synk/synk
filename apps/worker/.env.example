# Worker-specific configuration — shared vars are loaded from root .env via --env-file=../../.env.
# Only define values here that are specific to this app or override the root .env.

# Logging
LOG_LEVEL=info

# Number of concurrent jobs processed by the worker
WORKER_CONCURRENCY=5

# Suggestion inbox rollout controls
SYNK_SUGGESTION_INBOX_ENABLED=false
SYNK_AUTOPR_DISABLED=false
SYNK_SUGGESTION_DECISION_MEMORY_ENABLED=false
