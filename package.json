{
	"name": "synk-ai",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:write": "turbo run lint:write",
		"lint:unsafe": "turbo run lint:unsafe",
		"format": "biome format --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"db:generate": "bun run --filter @synk-ai/db db:generate",
		"db:migrate": "bun run --filter @synk-ai/db db:migrate",
		"db:studio": "bun run --filter @synk-ai/db db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"bun-types": "^1.3.9",
		"turbo": "^2.8.9",
		"typescript": "5.9.2"
	},
	"packageManager": "bun@1.3.9",
	"engines": {
		"bun": ">=1.0.0"
	}
}
