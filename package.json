{
	"name": "synk-ai",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --filter=./apps/*",
		"lint": "turbo run lint",
		"lint:write": "turbo run lint:write",
		"lint:unsafe": "turbo run lint:unsafe",
		"format": "biome format --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"openapi:generate": "turbo run openapi:generate --filter=@synk-ai/api-client",
		"openapi:check": "bun run openapi:generate && git diff --exit-code -- apps/api/openapi/openapi.json packages/api-client/src/generated/openapi.ts",
		"openapi:diff": "./scripts/openapi-diff.sh",
		"migration:integrity": "./scripts/check-migration-integrity.sh",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"db:generate": "bun run --filter @synk-ai/db db:generate",
		"db:migrate": "bun run --filter @synk-ai/db db:migrate",
		"db:studio": "bun run --filter @synk-ai/db db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"bun-types": "^1.3.9",
		"openapi-diff": "^0.24.1",
		"openapi-typescript": "^7.13.0",
		"turbo": "^2.8.9",
		"typescript": "5.9.2"
	},
	"packageManager": "bun@1.3.9",
	"engines": {
		"bun": ">=1.0.0"
	}
}
