{
	"name": "@synk-ai/api-client",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": ["src"],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "bun run generate && bunx tsc --noEmit",
		"generate": "openapi-typescript ../../apps/api/openapi/openapi.json -o src/generated/openapi.ts",
		"lint": "biome check .",
		"lint:write": "biome check . --write",
		"lint:unsafe": "biome check . --write --unsafe",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun run typecheck"
	},
	"devDependencies": {
		"typescript": "5.9.2"
	}
}
