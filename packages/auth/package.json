{
	"name": "@synk-ai/auth",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": ["dist"],
	"exports": {
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"generate": "pnpm dlx @better-auth/cli generate --config src/cli.ts --output ../db/src/schemas/auth.prisma",
		"lint": "biome check .",
		"typecheck": "bun run --filter @synk-ai/db build && bunx tsc --noEmit",
		"test": "echo 'auth test placeholder'"
	},
	"dependencies": {
		"@synk-ai/db": "workspace:*",
		"better-auth": "^1.4.18"
	},
	"devDependencies": {
		"typescript": "5.9.2"
	}
}
