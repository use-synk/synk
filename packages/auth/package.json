{
	"name": "@synk-ai/auth",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": ["dist"],
	"exports": {
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"generate": "bunx @better-auth/cli generate --config src/cli.ts --output ../db/src/schemas/auth.prisma",
		"lint": "biome check .",
		"lint:write": "biome check . --write",
		"lint:unsafe": "biome check . --write --unsafe",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test src --coverage"
	},
	"dependencies": {
		"@prisma/client": "^7.4.0",
		"@synk-ai/db": "workspace:*",
		"better-auth": "^1.5.1"
	},
	"devDependencies": {
		"typescript": "5.9.2"
	}
}
