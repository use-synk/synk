{
	"name": "@synk-ai/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": ["dist", "src/generated/prisma"],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/generated/prisma/client.d.ts",
			"default": "./dist/generated/prisma/client.js"
		}
	},
	"scripts": {
		"build": "prisma generate --config src/prisma.config.ts && tsc -p tsconfig.json",
		"lint": "biome check .",
		"lint:write": "biome check . --write",
		"lint:unsafe": "biome check . --write --unsafe",
		"typecheck": "prisma generate --config src/prisma.config.ts && bunx tsc --noEmit",
		"test": "bun test src --coverage",
		"generate": "prisma generate --config src/prisma.config.ts",
		"db:generate": "prisma generate --config src/prisma.config.ts",
		"db:migrate": "prisma migrate dev --config src/prisma.config.ts",
		"db:studio": "prisma studio --config src/prisma.config.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.4.0",
		"@prisma/client": "^7.4.0",
		"@synk-ai/shared": "workspace:*",
		"dotenv": "^17.3.1",
		"pg": "^8.16.3"
	},
	"peerDependencies": {
		"@prisma/client": "^7.4.0"
	},
	"devDependencies": {
		"@types/node": "^22.17.2",
		"@types/pg": "^8.15.5",
		"prisma": "^7.4.0",
		"tsx": "^4.20.5",
		"typescript": "5.9.2"
	}
}
