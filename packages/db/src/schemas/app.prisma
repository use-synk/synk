// App domain schema — provider-agnostic v2
// Tenancy: every installation belongs to exactly one Organization (from auth.prisma).

enum VcsProvider {
  github
  gitlab
  bitbucket

  @@map("vcs_provider")
}

enum InstallationStatus {
  active
  suspended
  deleted

  @@map("installation_status")
}

enum RepositoryStatus {
  active
  archived
  removed

  @@map("repository_status")
}

enum RunStatus {
  queued
  running
  completed
  skipped
  failed
  canceled

  @@map("run_status")
}

enum RunTriggerType {
  push
  merge
  manual

  @@map("run_trigger_type")
}

enum SuggestionStatus {
  pending
  accepted
  declined
  superseded
  stale
  applied

  @@map("suggestion_status")
}

enum SuggestionBatchStatus {
  queued
  running
  completed
  failed

  @@map("suggestion_batch_status")
}

enum AttemptStatus {
  running
  failed
  completed

  @@map("attempt_status")
}

enum WebhookStatus {
  received
  processed
  ignored
  failed

  @@map("webhook_status")
}

enum InstallationOAuthStateStatus {
  pending
  consumed
  expired

  @@map("installation_oauth_state_status")
}

model ProviderInstallation {
  id                     String               @id @default(uuid())
  organizationId         String               @db.Uuid
  organization           Organization         @relation(fields: [organizationId], references: [id])
  provider               VcsProvider
  providerInstallationId String
  providerAccountId      String
  accountLogin           String
  accountType            String
  status                 InstallationStatus   @default(active)
  installedAt            DateTime             @default(now())
  deletedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  repositories           ProviderRepository[]

  @@unique([provider, providerInstallationId])
  @@unique([provider, providerAccountId, providerInstallationId])
  @@unique([id, provider])
  @@index([provider, status])
  @@index([accountLogin])
  @@map("provider_installations")
}

model ProviderRepository {
  id                   String               @id @default(uuid())
  installationId       String
  installation         ProviderInstallation @relation(fields: [installationId], references: [id])
  provider             VcsProvider
  providerRepositoryId String
  ownerLogin           String
  name                 String
  fullName             String
  defaultBranch        String
  status               RepositoryStatus     @default(active)
  isActive             Boolean              @default(true)
  lastSyncedAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  analysisRuns         AnalysisRun[]
  suggestions          Suggestion[]
  suggestionBatches    SuggestionBatch[]

  projectSources Project[] @relation("SourceRepository")
  docsSources    Project[] @relation("DocsRepository")

  @@unique([provider, providerRepositoryId])
  @@unique([installationId, fullName])
  @@unique([id, provider])
  @@index([installationId])
  @@index([provider, isActive])
  @@index([provider, fullName])
  @@map("provider_repositories")
}

model AnalysisRun {
  id                        String               @id @default(uuid())
  projectId                 String
  project                   Project              @relation(fields: [projectId], references: [id])
  repositoryId              String
  repository                ProviderRepository   @relation(fields: [repositoryId], references: [id])
  provider                  VcsProvider
  triggerType               RunTriggerType
  triggerRef                String
  triggerCommitSha          String
  triggerMergeRequestNumber Int?
  triggerPrTitle            String?
  triggerSourceBranch       String?
  triggerTargetBranch       String?
  triggerPrAuthorName       String?
  triggerPrAuthorUsername   String?
  triggerPrAuthorAvatarUrl  String?
  triggerMeta               Json                 @default("{}")
  status                    RunStatus
  result                    Json                 @default("{}")
  docsAffected              Boolean?
  suggestionsCount          Int                  @default(0)
  docPrNumber               Int?
  docPrUrl                  String?
  tokenUsage                Json                 @default("{}")
  error                     String?
  errorCode                 String?
  errorMessage              String?
  attemptCount              Int                  @default(0)
  queuedAt                  DateTime             @default(now())
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  attempts                  AnalysisRunAttempt[]
  suggestions               Suggestion[]

  @@unique([projectId, repositoryId, triggerCommitSha, triggerType])
  @@index([projectId])
  @@index([status])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, createdAt(sort: Desc)])
  @@index([provider, triggerCommitSha])
  @@map("analysis_runs")
}

model AnalysisRunAttempt {
  id            String        @id @default(uuid())
  runId         String
  run           AnalysisRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        AttemptStatus
  error         String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@unique([runId, attemptNumber])
  @@index([runId])
  @@index([status])
  @@map("analysis_run_attempts")
}

// No FK relations — uses raw provider string IDs intentionally.
// InstallationOAuthState stores ephemeral CSRF state for the GitHub App
// installation OAuth flow. Cross-schema IDs (userId, organizationId) are
// stored as raw strings — no FK to auth tables, same pattern as WebhookDelivery.
model InstallationOAuthState {
  id             String                       @id @default(uuid())
  token          String                       @unique
  userId         String
  organizationId String
  status         InstallationOAuthStateStatus @default(pending)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime                     @default(now())

  @@index([expiresAt]) // Supports periodic cleanup of expired tokens
  @@map("installation_oauth_states")
}

// No FK relations — uses raw provider string IDs intentionally.
// WebhookDelivery is append-only and must survive installation deletion.
model WebhookDelivery {
  id                     String        @id @default(uuid())
  provider               VcsProvider
  deliveryId             String
  eventType              String
  providerInstallationId String?
  providerRepositoryId   String?
  signatureValid         Boolean
  payloadHash            String
  receivedAt             DateTime      @default(now())
  processedAt            DateTime?
  status                 WebhookStatus @default(received)
  error                  String?

  @@unique([provider, deliveryId])
  @@index([provider, eventType, receivedAt(sort: Desc)])
  @@index([provider, providerInstallationId, receivedAt(sort: Desc)])
  @@index([provider, providerRepositoryId, receivedAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model Project {
  id                 String              @id @default(uuid())
  name               String
  organizationId     String              @db.Uuid
  organization       Organization        @relation(fields: [organizationId], references: [id])
  sourceRepository   ProviderRepository  @relation("SourceRepository", fields: [sourceRepositoryId], references: [id])
  sourceRepositoryId String
  docsRepository     ProviderRepository? @relation("DocsRepository", fields: [docsRepositoryId], references: [id])
  docsRepositoryId   String?
  config             Json                @default("{}")

  analysisRuns       AnalysisRun[]
  suggestions        Suggestion[]
  suggestionBatches  SuggestionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceRepositoryId])
  @@index([docsRepositoryId])
  @@map("projects")
}

model SuggestionBatch {
  id              String                @id @default(uuid())
  projectId       String
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId    String
  repository      ProviderRepository    @relation(fields: [repositoryId], references: [id])
  createdByUserId String                @db.Uuid
  baseBranch      String
  baseSha         String
  headBranch      String
  prNumber        Int?
  prUrl           String?
  status          SuggestionBatchStatus @default(queued)
  summary         Json                  @default("{}")
  error           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  suggestions Suggestion[]

  @@index([projectId])
  @@index([repositoryId])
  @@index([createdByUserId])
  @@index([projectId, status, createdAt(sort: Desc)])
  @@map("suggestion_batches")
}

model Suggestion {
  id                    String          @id @default(uuid())
  projectId             String
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId          String
  repository            ProviderRepository @relation(fields: [repositoryId], references: [id])
  runId                 String
  run                   AnalysisRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  docPath               String
  baseDocSha            String
  beforeContent         String?
  proposedContent       String
  reasoning             String?
  fingerprint           String
  status                SuggestionStatus @default(pending)
  supersedesSuggestionId String?
  supersedesSuggestion  Suggestion?     @relation("SuggestionSupersede", fields: [supersedesSuggestionId], references: [id])
  supersededBy          Suggestion[]    @relation("SuggestionSupersede")
  decidedByUserId       String?         @db.Uuid
  decidedAt             DateTime?
  decisionNote          String?
  appliedInBatchId      String?
  appliedInBatch        SuggestionBatch? @relation(fields: [appliedInBatchId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([projectId])
  @@index([repositoryId])
  @@index([runId])
  @@index([appliedInBatchId])
  @@index([projectId, status, createdAt(sort: Desc)])
  @@index([projectId, fingerprint, status])
  @@map("suggestions")
}
