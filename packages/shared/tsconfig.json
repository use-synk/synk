{
	"extends": "../config/tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": ["node"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2023",
		"strict": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts"]
}
