{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": [
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_GITHUB_CLIENT_ID",
		"BETTER_AUTH_GITHUB_CLIENT_SECRET",
		"NEXT_PUBLIC_API_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"],
			"outputs": []
		},
		"lint:write": {
			"dependsOn": ["^lint:write"],
			"outputs": []
		},
		"lint:unsafe": {
			"dependsOn": ["^lint:unsafe"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "**/*.test.tsx"],
			"outputs": ["coverage/**"]
		},
		"openapi:generate": {
			"dependsOn": ["^openapi:generate"],
			"outputs": ["openapi/openapi.json", "src/generated/**"]
		},
		"@synk-ai/api#openapi:generate": {
			"dependsOn": ["@synk-ai/shared#build"],
			"outputs": ["openapi/openapi.json"]
		},
		"@synk-ai/api-client#openapi:generate": {
			"dependsOn": ["@synk-ai/api#openapi:generate"],
			"outputs": ["src/generated/**"]
		}
	}
}
